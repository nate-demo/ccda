# =============================================================================
# CCDA — Azure provider configuration (SAMPLE / environment-variable form)
#
# Copy to `.env` (git-ignored) or paste these as App Service / Container App
# application settings to switch the API from the offline mock providers to the
# Azure-backed ones. Values map 1:1 to the outputs of `infra/main.bicep`.
#
# The turnkey `azd up` path sets all of this for you automatically (see
# src/CCDA.AppHost/AppHost.cs) — this file is for the MANUAL / App Service path.
#
# No keys/secrets are needed: leave every ApiKey empty so the app authenticates
# with the user-assigned managed identity via DefaultAzureCredential. The
# deployed Search + OpenAI resources have local auth disabled.
#
# FOR DEMONSTRATION PURPOSES ONLY — FICTIONAL CASE DATA.
# =============================================================================

# --- Azure AI Search  (bicep output: searchEndpoint) --------------------------
# Search auto-switches to Azure as soon as this endpoint is set.
Azure__Search__Endpoint=https://ccda-search.search.windows.net

# --- Azure OpenAI / Foundry — chat  (bicep outputs: foundryEndpoint, chatDeploymentName)
Azure__Foundry__Provider=AzureOpenAI
Azure__Foundry__Endpoint=https://ccda-openai.openai.azure.com/
Azure__Foundry__ChatDeployment=gpt-4o-mini

# --- Azure OpenAI / Foundry — embeddings  (bicep outputs: foundryEndpoint, embeddingDeploymentName)
Ccda__Embeddings__Provider=AzureOpenAI
Ccda__Embeddings__Endpoint=https://ccda-openai.openai.azure.com/
Ccda__Embeddings__Deployment=text-embedding-3-small

# --- Telemetry  (bicep output: appInsightsConnectionString) -------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://REGION.in.applicationinsights.azure.com/

# --- Managed identity  (bicep output: workloadClientId) -----------------------
# The client id of the user-assigned identity assigned to the compute host.
# Required so DefaultAzureCredential selects the right identity.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
