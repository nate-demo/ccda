@* Renders the grounded citations backing an AI response: source file, page, type, and snippet. *@
@if (Citations is { Count: > 0 })
{
    <div class="mt-3">
        <h6 class="text-uppercase text-muted small mb-2">
            <span class="bi bi-quote" aria-hidden="true"></span> Sources (@Citations.Count)
        </h6>
        <ol class="list-group list-group-numbered">
            @foreach (var citation in Citations)
            {
                <li class="list-group-item">
                    <div class="fw-semibold">
                        @citation.SourceFile <span class="text-muted">· p.@citation.PageNumber · @Humanize(citation.DocumentType)</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(citation.Snippet))
                    {
                        <div class="small text-muted fst-italic">&ldquo;@citation.Snippet&rdquo;</div>
                    }
                </li>
            }
        </ol>
    </div>
}
else
{
    <div class="text-muted small mt-2">No source citations were returned for this response.</div>
}

@code {
    [Parameter]
    public IReadOnlyList<Citation>? Citations { get; set; }

    private static string Humanize(DocumentType type)
    {
        var name = type.ToString();
        var chars = new List<char>(name.Length + 4);
        for (var i = 0; i < name.Length; i++)
        {
            if (i > 0 && char.IsUpper(name[i]))
            {
                chars.Add(' ');
            }

            chars.Add(name[i]);
        }

        return new string([.. chars]);
    }
}
