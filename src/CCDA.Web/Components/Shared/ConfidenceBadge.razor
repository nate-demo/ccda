@* Renders a confidence assessment as a coloured badge with score, level, and rationale tooltip. *@
@if (Assessment is not null)
{
    <span class="badge rounded-pill @CssClass" title="@Assessment.Rationale">
        <span class="bi bi-patch-check" aria-hidden="true"></span>
        Confidence: @Assessment.Level (@Assessment.Score.ToString("0.00")) · @Assessment.CitationCount citation@(Assessment.CitationCount == 1 ? "" : "s")
    </span>
}

@code {
    [Parameter]
    public ConfidenceAssessment? Assessment { get; set; }

    private string CssClass => Assessment?.Level switch
    {
        ConfidenceLevel.High => "text-bg-success",
        ConfidenceLevel.Medium => "text-bg-warning",
        _ => "text-bg-secondary",
    };
}
